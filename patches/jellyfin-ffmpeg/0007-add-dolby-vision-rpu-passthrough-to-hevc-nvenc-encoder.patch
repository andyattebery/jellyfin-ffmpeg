++
++#ifndef AVCODEC_DOVI_P81_H
++#define AVCODEC_DOVI_P81_H
++
++#include <stddef.h>
++
++#include "libavutil/dovi_meta.h"
++#include "libavutil/frame.h"
++#include "libavutil/opt.h"
++
++#include "avcodec.h"
++
++/*
++ * Shared by every hardware encoder that passes a Dolby Vision RPU through.
++ *
++ * Both VAAPI and NVENC need exactly the same two fixups and neither is
++ * vendor-specific:
++ *
++ *   - Profiles 4 and 7 carry an enhancement layer that the hardware decoder
++ *     has already dropped and no hardware encoder can emit, so the RPU has to
++ *     be brought to the single-layer profile 8 shape or it describes a layer
++ *     that is not in the stream.
++ *   - Level 5 offsets are absolute pixels and mean nothing after a rescale.
++ *
++ * Keeping one copy is deliberate: the FEL mapping reset below was missing for
++ * a full round of hardware verification before a ten-title screen caught it,
++ * and a second copy is a second place for that to happen.
++ */
++
++enum FFDoviP81L5Mode {
++    FF_DOVI_P81_L5_KEEP = 0,    ///< pass the source offsets through unchanged
++    FF_DOVI_P81_L5_ZERO,        ///< clear them, for a chain that cropped the bars
++    FF_DOVI_P81_L5_SCALE,       ///< rescale them from the canvas to the output
++};
++
++typedef struct FFDoviP81 {
++    /* AVOptions, declared by FF_DOVI_P81_L5_OPTIONS(). */
++    int l5_mode;
++    /* Written as a pair by AV_OPT_TYPE_IMAGE_SIZE; must stay adjacent. */
++    int l5_canvas_w;
++    int l5_canvas_h;
++
++    /* Log/warn-once latches. Not options. */
++    int logged_p7;
++    int warned_l5_keep;
++    int warned_no_profile;
++} FFDoviP81;
++
++/**
++ * Produce a writable copy of @p sd's metadata with the profile 8.1 fixups
++ * applied.
++ *
++ * On success *out holds either the adjusted copy, which the caller must
++ * av_free(), or NULL when nothing needed changing and the caller should use
++ * the original side data. AVDOVIMetadata is a flat buffer addressed by
++ * internal byte offsets, so copying the side data verbatim keeps every
++ * accessor valid.
++ *
++ * @param avctx  encoder context, used for logging and for the output
++ *               dimensions that dv_l5=scale rescales towards
++ * @param s      per-encoder state; the caller owns it and it carries the
++ *               warn-once latches, so warnings fire once per encode
++ * @param sd     the frame's AV_FRAME_DATA_DOVI_METADATA side data
++ * @param out    receives the adjusted metadata, or NULL
++ * @return 0 on success, a negative AVERROR on failure
++ */
++int ff_dovi_p81_fixup(AVCodecContext *avctx, FFDoviP81 *s,
++                      const AVFrameSideData *sd, AVDOVIMetadata **out);
++
++/**
++ * Validate the dv_l5 options at init.
++ *
++ * dv_l5=scale divides by the canvas dimensions, so an unset canvas is a
++ * division by zero at the first letterboxed frame rather than a diagnostic.
++ * Shared so that an encoder adopting these options cannot forget the check.
++ *
++ * @return 0 if the options are usable, AVERROR(EINVAL) otherwise
++ */
++int ff_dovi_p81_check_options(void *logctx, const FFDoviP81 *s);
++
++/*
++ * The dv_l5 options, so that every encoder carrying this feature spells them
++ * the same way. @p p81_off is offsetof(PrivContext, <the FFDoviP81 member>).
++ *
++ * `dolbyvision` itself is not here: it lives in DOVIContext, which encoders
++ * embed separately, exactly as libx265.c declares it.
++ */
++#define FF_DOVI_P81_L5_OPTIONS(p81_off, opt_flags)                                    \
++    { "dv_l5", "Dolby Vision L5 (active area) handling",                          \
++      (p81_off) + offsetof(FFDoviP81, l5_mode), AV_OPT_TYPE_INT,                  \
++      { .i64 = FF_DOVI_P81_L5_KEEP },                                             \
++      FF_DOVI_P81_L5_KEEP, FF_DOVI_P81_L5_SCALE, opt_flags, .unit = "dv_l5" },        \
++    {   "keep",  "Pass the source offsets through unchanged",                     \
++      0, AV_OPT_TYPE_CONST, { .i64 = FF_DOVI_P81_L5_KEEP },                       \
++      .flags = opt_flags, .unit = "dv_l5" },                                          \
++    {   "zero",  "Clear the offsets, for when the bars have been cropped away",    \
++      0, AV_OPT_TYPE_CONST, { .i64 = FF_DOVI_P81_L5_ZERO },                       \
++      .flags = opt_flags, .unit = "dv_l5" },                                          \
++    {   "scale", "Rescale the offsets from dv_l5_canvas to the output size",      \
++      0, AV_OPT_TYPE_CONST, { .i64 = FF_DOVI_P81_L5_SCALE },                      \
++      .flags = opt_flags, .unit = "dv_l5" },                                          \
++    { "dv_l5_canvas", "Frame size the source Dolby Vision L5 offsets refer to "    \
++      "(required by dv_l5=scale)",                                                \
++      (p81_off) + offsetof(FFDoviP81, l5_canvas_w), AV_OPT_TYPE_IMAGE_SIZE,        \
++      { .str = NULL }, 0, 0, opt_flags }
++
++#endif /* AVCODEC_DOVI_P81_H */
