++++ b/libavcodec/dovi_p81.c
+@@ -0,0 +1,236 @@
++/*
++ * Dolby Vision profile 8.1 conversion, shared between hardware encoders.
++ *
++ * This file is part of FFmpeg.
++ *
++ * FFmpeg is free software; you can redistribute it and/or
++ * modify it under the terms of the GNU Lesser General Public
++ * License as published by the Free Software Foundation; either
++ * version 2.1 of the License, or (at your option) any later version.
++ *
++ * FFmpeg is distributed in the hope that it will be useful,
++ * but WITHOUT ANY WARRANTY; without even the implied warranty of
++ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
++ * Lesser General Public License for more details.
++ *
++ * You should have received a copy of the GNU Lesser General Public
++ * License along with FFmpeg; if not, write to the Free Software
++ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
++ */
++
++#include <string.h>
++
++#include "libavutil/error.h"
++#include "libavutil/log.h"
++#include "libavutil/mem.h"
++
++#include "dovi_p81.h"
++#include "dovi_rpu.h"
++
++static unsigned dv_l5_rescale(unsigned offset, int num, int den)
++{
++    uint64_t v;
++
++    if (!offset || num == den)
++        return offset;
++
++    v = ((uint64_t)offset * num + den / 2) / den;
++    /* The L5 offsets are written as 13-bit fields. */
++    return v > 8191 ? 8191 : (unsigned)v;
++}
++
++/*
++ * Is this enhancement layer MEL (minimal) rather than FEL (full)?
++ *
++ * dovi_tool decides with get_enhancement_layer_type() -> el_type() -> is_mel(),
++ * which tests the NLQ payload. dovi_tool checks seven values because it keeps
++ * integer and fractional parts apart; FFmpeg packs them -- get_ue_coef() in
++ * dovi_rpudec.c returns (ipart << coef_log2_denom) | fpart -- so the same test
++ * is four comparisons per component here.
++ *
++ * Measured across ten profile 7 sources (coef_log2_denom 23 on all of them):
++ * MEL carries nlq_offset 0 and vdr_in_max int 1 / frac 0, FEL carries
++ * nlq_offset 512 and int 0 / frac 1048576. Either field discriminates alone;
++ * all four are checked to match the reference.
++ */
++static int dovi_el_is_mel(const AVDOVIRpuDataHeader *hdr,
++                          const AVDOVIDataMapping *map)
++{
++    const uint64_t one = 1ULL << hdr->coef_log2_denom;
++
++    if (map->nlq_method_idc == AV_DOVI_NLQ_NONE)
++        return 0;
++
++    for (int c = 0; c < 3; c++) {
++        const AVDOVINLQParams *nlq = &map->nlq[c];
++        if (nlq->nlq_offset != 0 || nlq->vdr_in_max != one ||
++            nlq->linear_deadzone_slope != 0 || nlq->linear_deadzone_threshold != 0)
++            return 0;
++    }
++    return 1;
++}
++
++/*
++ * Reset the three reshaping curves to the identity mapping, matching
++ * dovi_tool's set_empty_p81_mapping(). The source curves describe a base layer
++ * that expected the enhancement layer residual to be added on top; with the EL
++ * gone they describe something that no longer exists.
++ *
++ * The 1023 upper pivot is dovi_tool's own hardcoded value and assumes a 10-bit
++ * base layer. Matching the reference is what the RPU-diff verification tests,
++ * and every Dolby Vision title measured in this library is 10-bit.
++ */
++static void dovi_reset_mapping(const AVDOVIRpuDataHeader *hdr,
++                               AVDOVIDataMapping *map)
++{
++    for (int c = 0; c < 3; c++) {
++        AVDOVIReshapingCurve *curve = &map->curves[c];
++
++        memset(curve, 0, sizeof(*curve));
++        curve->num_pivots      = 2;
++        curve->pivots[0]       = 0;
++        curve->pivots[1]       = 1023;
++        curve->mapping_idc[0]  = AV_DOVI_MAPPING_POLYNOMIAL;
++        curve->poly_order[0]   = 1;
++        curve->poly_coef[0][0] = 0;
++        curve->poly_coef[0][1] = 1LL << hdr->coef_log2_denom;
++        curve->poly_coef[0][2] = 0;
++    }
++}
++
++int ff_dovi_p81_check_options(void *logctx, const FFDoviP81 *s)
++{
++    if (s->l5_mode == FF_DOVI_P81_L5_SCALE &&
++        (s->l5_canvas_w <= 0 || s->l5_canvas_h <= 0)) {
++        av_log(logctx, AV_LOG_ERROR, "dv_l5=scale requires dv_l5_canvas to be "
++               "set to the frame size the source L5 offsets refer to, "
++               "e.g. -dv_l5_canvas 3840x2160.\n");
++        return AVERROR(EINVAL);
++    }
++    return 0;
++}
++
++/*
++ * Level 5 states the active picture area as four pixel offsets from the frame
++ * edges, so that the display excludes letterbox bars from its analysis. The
++ * offsets are absolute pixels and mean nothing once the frame has been
++ * resized, and ff_dovi_rpu_generate() writes them through verbatim -- it has
++ * no idea what resolution it is encoding at. Fix them up here.
++ *
++ * On success *out holds either a writable copy of the metadata with L5
++ * adjusted, or NULL when nothing needed changing and the caller should use
++ * the original. AVDOVIMetadata is a flat buffer addressed by internal byte
++ * offsets, so copying the side data verbatim keeps every accessor valid.
++ */
++int ff_dovi_p81_fixup(AVCodecContext *avctx, FFDoviP81 *s,
++                      const AVFrameSideData *sd, AVDOVIMetadata **out)
++{
++    const AVDOVIMetadata *src = (const AVDOVIMetadata *)sd->data;
++    AVDOVIMetadata       *dst;
++    int src_profile, need_el_strip = 0, need_l5 = 0, is_mel = 0;
++
++    *out = NULL;
++
++    /* Profiles 4 and 7 carry an enhancement layer. The hardware decoder has
++     * already dropped it and these encoders cannot emit one, so the RPU must
++     * be brought to the single-layer profile 8 shape -- otherwise it is
++     * written out still describing an EL that is not in the stream, while the
++     * configuration record says profile 8. */
++    src_profile = ff_dovi_guess_profile_hevc(av_dovi_get_header(src));
++    if (src_profile == 4 || src_profile == 7) {
++        need_el_strip = 1;
++        /* MUST be decided here, on the untouched source: the EL type is
++         * derived from the NLQ payload, and the strip below clears
++         * nlq_method_idc before anything could test it. */
++        is_mel = dovi_el_is_mel(av_dovi_get_header(src),
++                                av_dovi_get_mapping(src));
++    }
++
++    if (s->l5_mode != FF_DOVI_P81_L5_KEEP) {
++        for (int i = 0; i < src->num_ext_blocks; i++) {
++            if (av_dovi_get_ext(src, i)->level == 5) {
++                need_l5 = 1;
++                break;
++            }
++        }
++    } else if (!s->warned_l5_keep) {
++        /* Cannot detect staleness here -- the encoder never sees the source
++         * size, which is why dv_l5=scale needs dv_l5_canvas. Warn on the
++         * situation instead, once. */
++        for (int i = 0; i < src->num_ext_blocks; i++) {
++            const AVDOVIDmData *dm = av_dovi_get_ext(src, i);
++            if (dm->level == 5 && (dm->l5.left_offset || dm->l5.right_offset ||
++                                   dm->l5.top_offset  || dm->l5.bottom_offset)) {
++                av_log(avctx, AV_LOG_WARNING, "Source carries non-zero Dolby "
++                       "Vision L5 active area offsets (%u/%u/%u/%u) and dv_l5 is "
++                       "'keep'. If this encode is scaled they are now wrong; see "
++                       "-dv_l5 scale and -dv_l5_canvas.\n",
++                       dm->l5.left_offset, dm->l5.right_offset,
++                       dm->l5.top_offset, dm->l5.bottom_offset);
++                s->warned_l5_keep = 1;
++                break;
++            }
++        }
++    }
++
++    if (!need_el_strip && !need_l5)
++        return 0;
++
++    dst = av_memdup(sd->data, sd->size);
++    if (!dst)
++        return AVERROR(ENOMEM);
++
++    if (need_el_strip) {
++        AVDOVIRpuDataHeader *hdr = av_dovi_get_header(dst);
++        AVDOVIDataMapping   *map = av_dovi_get_mapping(dst);
++
++        /* The two flags ff_dovi_guess_profile_hevc() keys on, plus the NLQ and
++         * the mapping partitions: both are written outside the
++         * nlq_method_idc != NONE gate in dovi_rpuenc.c, so leaving either would
++         * emit enhancement-layer data into a stream declaring no residual. */
++        hdr->el_spatial_resampling_filter_flag = 0;
++        hdr->disable_residual_flag             = 1;
++        map->nlq_method_idc                    = AV_DOVI_NLQ_NONE;
++        map->num_x_partitions                  = 1;
++        map->num_y_partitions                  = 1;
++
++        /* FEL only, matching dovi_tool's convert_to_p81_remove_mapping(). A MEL
++         * enhancement layer carries no residual to fold in, so its mapping is
++         * left alone. */
++        if (!is_mel)
++            dovi_reset_mapping(hdr, map);
++
++        if (!s->logged_p7) {
++            av_log(avctx, AV_LOG_INFO, "Converting Dolby Vision profile %d %s RPU "
++                   "to single-layer profile 8; the enhancement layer is not "
++                   "encoded%s.\n", src_profile, is_mel ? "MEL" : "FEL",
++                   is_mel ? "" : " and its reshaping mapping is dropped");
++            s->logged_p7 = 1;
++        }
++    }
++
++    for (int i = 0; need_l5 && i < dst->num_ext_blocks; i++) {
++        AVDOVIDmData *dm = av_dovi_get_ext(dst, i);
++        if (dm->level != 5)
++            continue;
++
++        if (s->l5_mode == FF_DOVI_P81_L5_ZERO) {
++            dm->l5.left_offset   = 0;
++            dm->l5.right_offset  = 0;
++            dm->l5.top_offset    = 0;
++            dm->l5.bottom_offset = 0;
++        } else {
++            dm->l5.left_offset =
++                dv_l5_rescale(dm->l5.left_offset, avctx->width, s->l5_canvas_w);
++            dm->l5.right_offset =
++                dv_l5_rescale(dm->l5.right_offset, avctx->width, s->l5_canvas_w);
++            dm->l5.top_offset =
++                dv_l5_rescale(dm->l5.top_offset, avctx->height, s->l5_canvas_h);
++            dm->l5.bottom_offset =
++                dv_l5_rescale(dm->l5.bottom_offset, avctx->height, s->l5_canvas_h);
++        }
++    }
++
++    *out = dst;
++    return 0;
++}
+--- a/libavcodec/nvenc.h
++++ b/libavcodec/nvenc.h
+@@ -37,6 +37,8 @@
+ #include "hwconfig.h"
+ 
+ #include "avcodec.h"
++#include "dovi_p81.h"
++#include "dovi_rpu.h"
+ 
+ #define MAX_REGISTERED_FRAMES 64
+ #define RC_MODE_DEPRECATED 0x800000
+@@ -135,6 +137,15 @@
+ 
+     void        *frame_opaque;
+     AVBufferRef *frame_opaque_ref;
++
++    /* Dolby Vision RPU for this frame, as a complete HEVC NAL unit (start
++     * code + header + payload), or NULL. It rides in this slot because the
